@base=http://127.0.0.1:8787

@adminPhone=09120000000
@adminPassword=123456

@userPhone=09121111111
@userPassword=12345


### ==================================
### 1) Login Admin
### ==================================

POST {{base}}/auth/login
Content-Type: application/json

{
  "phone":"{{adminPhone}}",
  "password":"{{adminPassword}}"
}


### بعد از اجرا توکن را اینجا قرار بده
