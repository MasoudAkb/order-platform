### ==================================
### 2) Login Customer
### ==================================

POST {{base}}/auth/login
Content-Type: application/json

{
  "phone":"{{userPhone}}",
  "password":"{{userPassword}}"
}


### بعد از اجرا توکن را اینجا قرار بده
@userToken=eyJhbGciOiJIUzI1NiJ9.eyJpZCI6Miwicm9sZSI6InVzZXIiLCJpYXQiOjE3ODYzODY4MzEsImV4cCI6MTc4Njk5MTYzMX0.axTCOC3YT33Lv5X99xITuibNjT0J0J1l9w7AhmFysII



### ==================================
### 3) دریافت پروفایل / تست احراز
### ==================================

GET {{base}}/wallet
Authorization: Bearer {{userToken}}



### ==================================
### 4) ساخت سفارش جدید
### ==================================

POST {{base}}/orders
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title":"تست کامل سیستم",
  "description":"تست مسیر کامل سفارش"
}


### سفارش ساخته شده id را اینجا بگذار
@orderId=8



### ==================================
### 5) لیست سفارش‌های مشتری
### ==================================

GET {{base}}/orders/history
Authorization: Bearer {{userToken}}




### ==================================
### 6) لیست سفارش‌های ادمین
### ==================================

GET {{base}}/admin/orders
Authorization: Bearer {{adminToken}}




### ==================================
### 7) جزئیات سفارش ادمین
### ==================================

GET {{base}}/admin/orders/{{orderId}}
Authorization: Bearer {{adminToken}}





### ==================================
### 8) تعیین قیمت
### ==================================

PATCH {{base}}/admin/orders/{{orderId}}/price
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "price":500000
}




### ==================================
### 9) تایید سفارش
### ==================================

POST {{base}}/admin/orders/{{orderId}}/approve
Authorization: Bearer {{adminToken}}





### ==================================
### 10) تکمیل سفارش
### ==================================

POST {{base}}/admin/orders/{{orderId}}/complete
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "result":"تعمیر با موفقیت انجام شد"
}





### ==================================
### 11) بررسی سفارش مشتری
### ==================================

GET {{base}}/orders/{{orderId}}
Authorization: Bearer {{userToken}}





### ==================================
### 12) کیف پول مشتری
### ==================================

GET {{base}}/wallet
Authorization: Bearer {{userToken}}





### ==================================
### 13) نوتیفیکیشن مشتری
### ==================================

GET {{base}}/notifications
Authorization: Bearer {{userToken}}





### ==================================
### 14) خواندن یک نوتیف
### ==================================

PATCH {{base}}/notifications/1/read
Authorization: Bearer {{userToken}}





### ==================================
### 15) خواندن همه نوتیف‌ها
### ==================================

PATCH {{base}}/notifications/read-all
Authorization: Bearer {{userToken}}





### ==================================
### 16) داشبورد ادمین
### ==================================

GET {{base}}/admin/dashboard
Authorization: Bearer {{adminToken}}





### ==================================
### 17) تراکنش‌های کیف پول ادمین
### ==================================

GET {{base}}/admin/wallet
Authorization: Bearer {{adminToken}}

### ==================================
### 17) تراکنش‌های کیف پول ادمین
### ==================================

GET {{base}}/admin/users
Authorization: Bearer {{adminToken}}

### ==================================
